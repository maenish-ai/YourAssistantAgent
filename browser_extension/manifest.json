{
  "manifest_version": 3,
  "name": "Your Assistant Agent Browser Bridge",
  "version": "2.0.1",
  "description": "Connects the normal open browser to Your Assistant Agent on this computer.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Your Assistant Agent"
  }
}
